	: CDialog(CLoopDlg::IDD, pParent)
{
	nWave = 0;
	fViewMin = 0.0f;
	fViewMax = 1.0f;
	fMMBDragCentre = -1.0f;

	//{{AFX_DATA_INIT(CLoopDlg)
		// NOTE: the ClassWizard will add member initialization here
	//}}AFX_DATA_INIT
}



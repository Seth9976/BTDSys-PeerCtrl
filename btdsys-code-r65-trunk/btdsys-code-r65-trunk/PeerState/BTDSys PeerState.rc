IDD_MACHINESELECTDLG DIALOG DISCARDABLE  0, 0, 150, 231
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Dialog"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Machines/params to include in snapshots:",IDC_STATIC,2,
                    2,146,11
    CONTROL         "Tree1",IDC_MACTREE,"SysTreeView32",TVS_HASBUTTONS | 
                    TVS_HASLINES | TVS_LINESATROOT | TVS_CHECKBOXES | 
                    WS_BORDER | WS_TABSTOP,2,15,146,181
    PUSHBUTTON      "Select All",IDC_SELALL,2,198,46,14
    PUSHBUTTON      "Select None",IDC_SELNONE,52,198,46,14
    PUSHBUTTON      "Invert Sel",IDC_SELINVERT,102,198,46,14
    DEFPUSHBUTTON   "OK",IDOK,2,215,146,14
END

IDD_DIALOG DIALOGEX 0, 0, 254, 98
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "BTDSys PeerState"
FONT 8, "MS Sans Serif", 0, 0, 0x1
BEGIN
    COMBOBOX        IDC_SNAPCOMBO,1,1,252,170,CBS_DROPDOWNLIST | WS_VSCROLL | 
                    WS_TABSTOP
    DEFPUSHBUTTON   "- T A K E   S N A P S H O T -",IDC_SNAP,1,42,252,34,0,
                    WS_EX_CLIENTEDGE
    EDITTEXT        IDC_NAME,29,15,224,14,ES_AUTOHSCROLL
    RTEXT           "Name:",IDC_STATIC,1,15,22,14,SS_CENTERIMAGE
    LTEXT           "In this dialog, you have to click the button above to store a snapshot of parameter states.",
                    IDC_STATIC,1,78,252,19
    CONTROL         "Disable restoring of snapshot (useful for overwriting a snapshot)",
                    IDC_DONTRESTORE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,1,
                    31,252,10
END


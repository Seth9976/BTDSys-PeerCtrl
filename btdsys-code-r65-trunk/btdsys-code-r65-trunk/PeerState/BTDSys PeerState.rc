    PUSHBUTTON      "Swap A and B",IDC_SWAP,98,116,92,14
    PUSHBUTTON      "Morph A with B",IDC_MORPH,2,134,92,14
    PUSHBUTTON      "Splice A with B",IDC_SPLICE,98,134,92,14
    CONTROL         "Slider1",IDC_AMOUNTSLIDER,"msctls_trackbar32",
                    TBS_AUTOTICKS | WS_TABSTOP,197,134,188,21
    PUSHBUTTON      "Randomise A",IDC_RANDOMISE,2,152,92,14
    CTEXT           "50%",IDC_AMOUNTTEXT,197,157,188,8
    CTEXT           "A            Morph/Splice/Randomise amount:            B",

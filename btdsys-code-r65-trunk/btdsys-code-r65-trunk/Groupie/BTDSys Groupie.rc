IDD_ADDMACHINE DIALOG DISCARDABLE  0, 0, 300, 231
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add machine"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Display:",IDC_STATIC,7,133,27,9
    CONTROL         "&All machines",IDC_RALL,"Button",BS_AUTORADIOBUTTON | 
                    WS_GROUP,40,133,197,10
    CONTROL         "&Generators only",IDC_RGENS,"Button",BS_AUTORADIOBUTTON,
                    40,144,197,10
    CONTROL         "&Effects only",IDC_REFFS,"Button",BS_AUTORADIOBUTTON,40,
                    155,197,10
    CONTROL         "&Index.txt tree view",IDC_RRECENT,"Button",
                    BS_AUTORADIOBUTTON,40,166,197,10
    CONTROL         "Machine&s whose name contains *all* of the following words:",
                    IDC_RSEARCH,"Button",BS_AUTORADIOBUTTON,40,177,206,10
    EDITTEXT        IDC_SEARCHBOX,51,191,242,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,243,7,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,243,24,50,14
    CONTROL         "Tree1",IDC_TREE,"SysTreeView32",TVS_HASBUTTONS | 
                    TVS_HASLINES | TVS_LINESATROOT | WS_BORDER | WS_TABSTOP,
                    7,7,230,122
END


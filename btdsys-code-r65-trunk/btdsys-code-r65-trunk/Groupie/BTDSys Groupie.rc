IDR_POPUPS MENU DISCARDABLE 
BEGIN
    POPUP "Machine"
    BEGIN
        MENUITEM "&Parameters...",              ID_MACHINE_PARAMETERS
        MENUITEM "&Attributes...",              ID_MACHINE_ATTRIBUTES
        MENUITEM SEPARATOR
        MENUITEM "&Rename...",                  ID_MACHINE_RENAME
        MENUITEM "&Delete",                     ID_MACHINE_DELETE
        MENUITEM SEPARATOR
        POPUP "MDK &Work Mode"
        BEGIN
            MENUITEM "&Mono",                       ID_MACHINE_MDKWORKMODE_MONO

            MENUITEM "&Stereo",                     ID_MACHINE_MDKWORKMODE_STEREO

        END
        MENUITEM "(dev) Work mode info",        ID_MACHINE_DEVWORKMODEINFO
        MENUITEM "(dev) Force exception",       ID_MACHINE_DEVFORCEEXCEPTION
        MENUITEM SEPARATOR
        MENUITEM "R&eplace...",                 ID_MACHINE_REPLACE
        MENUITEM "&Unload",                     ID_MACHINE_UNLOAD
    END
    POPUP "Connection"
    BEGIN
        MENUITEM "&Disconnect",                 ID_CONNECTION_DISCONNECT
        MENUITEM "&Center pan",                 ID_CONNECTION_CENTERPAN
    END
    POPUP "Param"
    BEGIN
        MENUITEM "Reset to &default",           ID_PARAM_RESETTODEFAULT
        MENUITEM "&Random",                     ID_PARAM_RANDOM
        MENUITEM SEPARATOR
        POPUP "&Bind"
        BEGIN
            MENUITEM "None",                        ID_PARAM_BIND_NONE
        END
    END
END

IDR_PARAMDLGMENU MENU DISCARDABLE 
BEGIN
    MENUITEM "Add new track",               ID_ADDNEWTRACK
    MENUITEM "Delete last track",           ID_DELETELASTTRACK
    POPUP "Presets"

IDR_PALWINDOW_MENU MENU DISCARDABLE 
BEGIN
    POPUP "&Updating"
    BEGIN
        MENUITEM "Update &Now!\tSpace",         ID_UPDATING_UPDATENOW
    END
    POPUP "&Transparency"
    BEGIN
        MENUITEM "All transparency off",        ID_TRANSPARENCY_ALLTRANSPARENCYOFF

        MENUITEM "Toggle keyed background",     ID_TRANSPARENCY_TOGGLEKEYEDBACKGROUND

        MENUITEM SEPARATOR
        MENUITEM "100%",                        ID_TRANSPARENCY_100OFF
        MENUITEM "90%",                         ID_TRANSPARENCY_90
        MENUITEM "80%",                         ID_TRANSPARENCY_80
        MENUITEM "70%",                         ID_TRANSPARENCY_70
        MENUITEM "60%",                         ID_TRANSPARENCY_60
        MENUITEM "50%",                         ID_TRANSPARENCY_50
        MENUITEM "40%",                         ID_TRANSPARENCY_40
        MENUITEM "30%",                         ID_TRANSPARENCY_30
        MENUITEM "20%",                         ID_TRANSPARENCY_20
        MENUITEM "10%",                         ID_TRANSPARENCY_10
    END
    MENUITEM "&Preferences...",             ID_PREFERENCES
    MENUITEM "&About...",                   ID_ABOUT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_MIXERDIALOG DIALOG DISCARDABLE  0, 0, 248, 257
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "BTDSys PeerCtrl - Mixer GUI Window"
MENU IDR_MIXERMENU
FONT 8, "MS Sans Serif"
BEGIN
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MIXERMENU MENU DISCARDABLE 
BEGIN
    MENUITEM "Add new channel",             IDM_ADD
    MENUITEM "Delete last channel",         IDM_DELETE
    POPUP "Knob mode"
    BEGIN
        MENUITEM "Rotary with min/max wraparound", ID_KNOBMODE_ROTWRAP
        , CHECKED
        MENUITEM "Rotary with no wraparound",   ID_KNOBMODE_ROTNOWRAP
        MENUITEM "Linear - vertical",           ID_KNOBMODE_LINVERT
        MENUITEM "Linear - horizontal",         ID_KNOBMODE_LINHORZ
    END
END

IDR_MIXERPOPUP MENU DISCARDABLE 
BEGIN
    POPUP "Knob"
    BEGIN
        POPUP "Set to"
        BEGIN
            MENUITEM "Min",                         IDM_KNOBMIN
            MENUITEM "Center",                      IDM_KNOBCENTER
            MENUITEM "Max",                         IDM_KNOBMAX
        END
        MENUITEM "Change colour...",            IDM_KNOBCOLOUR
    END
    POPUP "Slider"
    BEGIN
        POPUP "Set to"
        BEGIN
            MENUITEM "Min",                         IDM_SLIDERMIN
            MENUITEM "Center",                      IDM_SLIDERCENTER
            MENUITEM "Max",                         IDM_SLIDERMAX
        END
        MENUITEM "Change colour...",            IDM_SLIDERCOLOUR
    END
END



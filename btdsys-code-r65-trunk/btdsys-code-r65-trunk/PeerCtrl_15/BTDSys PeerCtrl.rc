IDD_SETTINGSDIALOG DIALOGEX 0, 0, 366, 218
STYLE DS_SETFONT | DS_MODALFRAME | DS_NOFAILCREATE | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "BTDSys PeerCtrl - Settings"
FONT 8, "MS Sans Serif", 0, 0, 0x0
BEGIN
    LTEXT           "A&ssignments:",IDC_STATIC,7,7,93,11
    CONTROL         "Tree1",IDC_ASSIGNTREE,"SysTreeView32",TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_DISABLEDRAGDROP | TVS_SHOWSELALWAYS | TVS_FULLROWSELECT | WS_BORDER | WS_TABSTOP,7,18,93,163
    COMBOBOX        IDC_MACHINECOMBO,107,18,139,123,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LISTBOX         IDC_PARAMLIST,107,35,139,134,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Track:",IDC_STATIC,107,169,27,12,SS_CENTERIMAGE
    COMBOBOX        IDC_TRACKCOMBO,135,169,48,71,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Update",IDC_ARROWBUTTON,7,185,43,13
    PUSHBUTTON      "&Add",IDC_ADDBUTTON2,57,185,43,13
    PUSHBUTTON      "&Clear",IDC_CLEARBUTTON,7,198,43,13
    PUSHBUTTON      "&Delete",IDC_DELBUTTON,57,198,43,13
    PUSHBUTTON      "Machine &Info...",IDC_MACINFOBUTTON,107,7,64,11
    PUSHBUTTON      "&Param Info...",IDC_PARINFOBUTTON,182,7,64,11
    PUSHBUTTON      "De&fault",IDC_RESETBUTTON,310,18,34,12
    CONTROL         "",IDC_MAPPINGENVELOPE,
                    "{396D2EB7-53AA-11D1-A1D9-4676EE000000}",WS_TABSTOP,261,35,98,91
    PUSHBUTTON      "C&ontrol Plugin Settings...",IDC_PLUGINBTN,250,169,109,12
    DEFPUSHBUTTON   "OK",IDOK,309,185,50,26
    LTEXT           "Value Mapping",IDC_STATIC,253,18,49,12
    CTEXT           "P\na\nr\na\nm\nV\na\nl\nu\ne",IDC_STATIC,250,35,10,90
    RTEXT           "Specified Value",IDC_STATIC,266,129,93,10
    PUSHBUTTON      "&MIDI CC Settings...",IDC_MIDICCBTN,250,152,109,12
    PUSHBUTTON      "+",IDC_MAPPINGWINDOW,345,18,14,12
END

IDD_MIDIDIALOG DIALOG  0, 0, 314, 130
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "BTDSys PeerCtrl - MIDI CC Settings"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,3,113,50,14
    CTEXT           "Info here",IDC_ASSIGNINFO,3,3,308,19,SS_SUNKEN
    LTEXT           "Controller to use:",IDC_STATIC,13,38,57,12
    COMBOBOX        IDC_CCCOMBO,74,34,68,151,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "[Move a controller and its channel/controller number will be displayed here]",IDC_LASTCONTROLLER,146,34,156,21
    LTEXT           "Channel:",IDC_STATIC,13,51,55,10
    COMBOBOX        IDC_CHANNELCOMBO,74,48,68,134,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Feedback thru MIDI out (for Pocket Dial), use device",IDC_FEEDBACKCHECK,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,64,182,10
    CONTROL         "Allow inc/dec (for Pocket Dial)",IDC_INCDECCHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,13,78,162,10
    COMBOBOX        IDC_OUTDEVCOMBO,196,62,108,92,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "^ This device MUST be selected as an ""output device"" in Buzz's preferences!",IDC_STATIC,196,78,106,29
    CONTROL         "Wrap values at ends of range",IDC_INCDECWRAPCHECK,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,29,90,150,8
    GROUPBOX        "MIDI Controllers",IDC_STATIC,3,26,308,83
END

